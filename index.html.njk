        let API_KEY = localStorage.getItem('fet_key_njk') || 'AIzaSyD4Z5xVJmLn5eG3p7kL5b0Xz8QbY0vWqRs';
        localStorage.setItem('fet_key_njk', API_KEY);

        const oldKeys = ['fet_reviews_dev', 'fet_reviews_pure', 'fet_reviews_company'];
        let lastData = [];
        oldKeys.forEach(k => {
            const d = JSON.parse(localStorage.getItem(k) || '[]');
            if (d.length > lastData.length) lastData = d;
        });
        storeData.forEach(s => {
            const p = lastData.find(x => x.ivr_code === s.ivr_code);
            s.previous = p ? Number(p.review_count) || 0 : 0;
            s.review_count = s.previous;
            s.update_time = p ? p.update_time : '';
        });

        function renderTable() {
            const tbody = document.querySelector('#storeTable tbody');
            tbody.innerHTML = '';
            storeData.forEach(s => {
                const c = Number(s.review_count) || 0;
                const p = Number(s.previous) || 0;
                const d = c - p;
                const txt = d > 0 ? `+${d}` : d === 0 ? '0' : d;
                const cls = d > 0 ? 'success' : '';
                tbody.innerHTML += `<tr class="${cls}">
                    <td>${s.ivr_code}</td>
                    <td>${s.store_name}</td>
                    <td class="link"><a href="${s.url}" target="_blank">開啟地圖</a></td>
                    <td>${p}</td>
                    <td>${c}</td>
                    <td class="new">${txt}</td>
                    <td>${s.update_time || '-'}</td>
                </tr>`;
            });
        }

        async function getReviewCount(id) {
            for (let i = 0; i < 6; i++) {  // 修正上一版的打字錯誤
                try {
                    const u = `https://maps.googleapis.com/maps/api/place/details/json?place_id=${id}&fields=user_ratings_total&key=${API_KEY}&language=zh-TW&region=tw`;
                    const r = await fetch(u, {cache: "no-store"});
                    const d = await r.json();
                    if (d.status === 'OK' && d.result?.user_ratings_total != null) return d.result.user_ratings_total;
                    if (d.status === 'OVER_QUERY_LIMIT') await new Promise(res => setTimeout(res, 5000));
                } catch (e) {}
                await new Promise(res => setTimeout(res, 500));
            }
            return '錯誤';
        }

        async function updateReviews() {
            const btn = document.querySelector('button[onclick="updateReviews()"]');
            btn.disabled = true;
            document.getElementById('progress').innerHTML = '.njk 核彈更新中（25秒90家）...';
            let success = 0;
            for (let i = 0; i < storeData.length; i++) {
                document.getElementById('progress').innerHTML = `更新：${storeData[i].store_name} (${i+1}/90)`;
                const cnt = await getReviewCount(storeData[i].place_id);
                storeData[i].review_count = cnt;
                storeData[i].update_time = new Date().toLocaleString('zh-TW');
                if (typeof cnt === 'number') success++;
                renderTable();
                await new Promise(res => setTimeout(res, 350));
            }
            localStorage.setItem('fet_reviews_njk', JSON.stringify(storeData.map(s => ({ivr_code: s.ivr_code, review_count: s.review_count, update_time: s.update_time})));
            document.getElementById('progress').innerHTML = `.njk 核彈完成！成功 ${success}/90（淡水竹圍 ${storeData.find(s => s.ivr_code === 1801517)?.review_count || '載入中'}）`;
            btn.disabled = false;
        }

        // 其餘函數不變（downloadExcel, showApiKeyModal, saveApiKey, clearAllData）
        function downloadExcel() { /* 同上一版 */ 
            const data = [["IVR Code","門市名稱","Google Maps","上次","最新","新增","更新時間"], ...storeData.map(s => [s.ivr_code, s.store_name, s.url, Number(s.previous)||0, Number(s.review_count)||0, (Number(s.review_count)||0)-(Number(s.previous)||0), s.update_time || ''])];
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet(data);
            XLSX.utils.book_append_sheet(wb, ws, "遠傳評論");
            XLSX.writeFile(wb, `遠傳90家_${new Date().toISOString().slice(0,10)}.xlsx`);
        }

        function showApiKeyModal() {
            document.getElementById('apiKeyModal').classList.add('show');
            document.getElementById('apiKeyInput').value = API_KEY;
        }

        function saveApiKey() {
            API_KEY = document.getElementById('apiKeyInput').value.trim();
            localStorage.setItem('fet_key_njk', API_KEY);
            alert('金鑰儲存成功！');
            document.getElementById('apiKeyModal').classList.remove('show');
        }

        function clearAllData() {
            if (confirm('確定清除所有舊資料？')) {
                localStorage.clear();
                storeData.forEach(s => { s.previous = 0; s.review_count = 0; s.update_time = ''; });
                renderTable();
                alert('清除完成！現在更新從0開始算新增');
            }
        }

        renderTable();
    </script>
